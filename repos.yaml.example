# name and path are unique in this file. Unknown keys are ignored.
# Omit branch to leave that repository's checkout unchanged.
workspace: ./repos           # directory where repos will be placed
worktrees: ./worktrees       # directory for git worktrees (optional, this is the default)

repositories:
  - name: project-a
    source: git@github.com:user/project-a.git
    branch: main
    path: project-a          # relative path within workspace

  - name: project-b
    source: git@github.com:user/project-b.git
    branch: develop
    path: project-b

  - name: local-lib
    source: /path/to/local-lib  # local path -> symlink
    type: symlink
    path: local-lib
